# Self-host production .env example.
# Copy to .env and fill in.
# Use with: docker compose -f docker-compose.prod.yml --env-file .env up -d

# Strong random password for Postgres. Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# JWT signing secret. MUST be at least 32 random characters or the API
# refuses to start. Generate with: openssl rand -hex 32
JWT_SECRET=

# Public URL of your UptimeCrow instance (used for CORS, email links, status pages).
# Example: https://uptime.yourdomain.com
APP_URL=

# Optional. Defaults to ${APP_URL}/status.
# STATUS_PAGE_URL=

# ── Optional integrations ───────────────────────────────────────────────
# Leave blank to disable. UptimeCrow runs fine without any of these.

# Amazon SES — email alerts to subscribers.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
SES_FROM_EMAIL=

# Polar — paid plan upgrades (only relevant if you intend to resell).
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
