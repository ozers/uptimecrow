# Self-host production .env example.
# Copy to .env and fill in.
# Use with: docker compose -f docker-compose.prod.yml --env-file .env up -d

# Strong random password for Postgres. Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# JWT signing secret. MUST be at least 32 random characters or the API
# refuses to start. Generate with: openssl rand -hex 32
JWT_SECRET=

# Public URL of your UptimeCrow instance (used for CORS, email links, status pages).
# Example: https://uptime.yourdomain.com
APP_URL=

# Optional. Defaults to ${APP_URL}/status.
# STATUS_PAGE_URL=

# ── Optional integrations ───────────────────────────────────────────────
# Leave blank to disable. UptimeCrow runs fine without any of these.

# Amazon SES — email alerts to subscribers.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
SES_FROM_EMAIL=

# Polar — paid plan upgrades (only relevant if you intend to resell).
# Checkout returns "Billing not configured" until ACCESS_TOKEN + the product IDs
# below are set. These are PRODUCT ids (Polar dashboard > Products, the id in
# the product URL), not price ids: Polar removed price-level ids from the
# checkout API, and a subscription webhook only carries product_id. Monthly and
# yearly are separate products. The legacy ..._PRICE_ID names are still read as
# a fallback, but the value must be a product id either way.
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_INDIE_MONTHLY_PRODUCT_ID=
POLAR_INDIE_YEARLY_PRODUCT_ID=
POLAR_PRO_MONTHLY_PRODUCT_ID=
POLAR_PRO_YEARLY_PRODUCT_ID=
POLAR_TEAM_MONTHLY_PRODUCT_ID=
POLAR_TEAM_YEARLY_PRODUCT_ID=

# Sentry — error tracking. Leave blank to disable (no-op without a DSN).
SENTRY_DSN=
# Optional: fraction of transactions to trace, 0..1 (default 0 = off).
SENTRY_TRACES_SAMPLE_RATE=
