# Database
DATABASE_URL=postgresql://uptimecrow:uptimecrow@localhost:5432/uptimecrow

# Redis
REDIS_URL=redis://localhost:6379

# App
MODE=all
PORT=3000
NODE_ENV=development
# LOG_LEVEL: trace|debug|info|warn|error|fatal|silent
# Defaults: info in prod, debug in dev, silent in tests
LOG_LEVEL=

# Auth — MUST be changed in production (startup fails if default)
JWT_SECRET=change-me-in-production

# Public URLs (used in emails and links)
APP_URL=http://localhost:5173
STATUS_PAGE_URL=http://localhost:5173/status

# Email (Amazon SES)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
SES_FROM_EMAIL=

# Analytics (web, optional — leave empty to disable)
# Set at build time so Vite substitutes the value in apps/web/index.html
VITE_PLAUSIBLE_DOMAIN=

# Billing (Polar). Product IDs, not price IDs — Polar dropped price-level ids
# from the checkout API. Monthly and yearly are separate Polar products.
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_INDIE_MONTHLY_PRODUCT_ID=
POLAR_INDIE_YEARLY_PRODUCT_ID=
POLAR_PRO_MONTHLY_PRODUCT_ID=
POLAR_PRO_YEARLY_PRODUCT_ID=
POLAR_TEAM_MONTHLY_PRODUCT_ID=
POLAR_TEAM_YEARLY_PRODUCT_ID=

# event-beacon (optional — self-hosted fleet event tracker, no-op when unset)
# Key: beacon dashboard > Apps & keys > uptimecrow
BEACON_URL=
BEACON_KEY=
