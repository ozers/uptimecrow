# Database
DATABASE_URL=postgresql://uptimecrow:uptimecrow@localhost:5432/uptimecrow

# Redis
REDIS_URL=redis://localhost:6379

# App
MODE=all
PORT=3000
NODE_ENV=development

# Auth — MUST be changed in production (startup fails if default)
JWT_SECRET=change-me-in-production

# Public URLs (used in emails and links)
APP_URL=http://localhost:5173
STATUS_PAGE_URL=http://localhost:5173/status

# Email (Amazon SES)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
SES_FROM_EMAIL=

# Billing (Polar)
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRO_PRODUCT_ID=
POLAR_TEAM_PRODUCT_ID=
